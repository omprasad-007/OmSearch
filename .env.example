# OM Search Environment Configuration

ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Host & Port
HOST=127.0.0.1
PORT=8000

# OpenSearch Service (Single-Node Dev)
OPENSEARCH_HOST=127.0.0.1
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=your_opensearch_password_here
OPENSEARCH_INDEX_NAME=om_documents_v1
OPENSEARCH_INDEX_ALIAS=om_documents

# PostgreSQL Database
POSTGRES_USER=om_user
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=om_search
DATABASE_URL=postgresql://om_user:your_postgres_password_here@127.0.0.1:5432/om_search

# SQLite Fallback (when PostgreSQL is not running)
SQLITE_FALLBACK_URL=sqlite:///./om_search_local.db
USE_SQLITE_FALLBACK_IF_UNAVAILABLE=true

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000

# Crawler Configuration (Phase 2)
CRAWLER_USER_AGENT=OMSearchBot/0.2 (+https://omsearch.org/bot; bot@omsearch.org)
CRAWLER_DEFAULT_DELAY=1.5
CRAWLER_MAX_PER_HOST_CONCURRENCY=1
CRAWLER_MAX_RESPONSE_BYTES=2097152
CRAWLER_CONNECT_TIMEOUT=5.0
CRAWLER_READ_TIMEOUT=8.0
CRAWLER_LEASE_SECONDS=90

# Google Drive Cloud Storage (Google One 5 TB Archive)
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/storage/google-drive/callback
GOOGLE_DRIVE_ROOT_FOLDER_NAME=OM-Search-Data
GOOGLE_DRIVE_STORAGE_BUDGET_BYTES=5497558138880
GOOGLE_DRIVE_ENABLED=true
OPERATOR_API_KEY=your-operator-secret-key-here

